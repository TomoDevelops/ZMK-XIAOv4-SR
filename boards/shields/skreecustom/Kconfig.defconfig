if SHIELD_SKREECUSTOM_LEFT

config ZMK_KEYBOARD_NAME
    default "Skree Custom"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_SKREECUSTOM_LEFT || SHIELD_SKREECUSTOM_RIGHT

config ZMK_SPLIT
    default y

config ZMK_SLEEP
    default y

config ZMK_POINTING
    default y


config SPI
    default y

config ZMK_RGB_UNDERGLOW_EXT_POWER
    default n

config ZMK_KSCAN_MATRIX_WAIT_BEFORE_INPUTS
    default 0

config ZMK_KSCAN_MATRIX_WAIT_BETWEEN_OUTPUTS
    default 1

# This must stay inside the shield guard. Outside it, it applied to every build
# in this module -- including the stock settings_reset shield, which has no
# led_strip node to imply WS2812_STRIP against. That is what was breaking the
# settings_reset build.
config ZMK_RGB_UNDERGLOW
    default y
    imply WS2812_STRIP

endif
